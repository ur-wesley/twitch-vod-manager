{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twitch VOD Manager",
  "version": "0.2.2",
  "identifier": "io.w4y.twitch-vod-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Twitch VOD Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMTI1NDgwMjIxQTBGMjUKUldRbER4b2lnRlFTSDFMeXkrTzEyRTZNRjhrMFl3RlNJY29Dc1F5VTYrTFZmb2V0bW1EVllCNkYK",
      "endpoints": [
        "https://github.com/ur-wesley/twitch-vod-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
