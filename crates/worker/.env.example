# Twitch VOD Manager Cloud Worker Configuration

# Port to listen on
WORKER_PORT=8080

# Secret API Key for authenticating requests from your desktop app
WORKER_API_KEY=generate_a_secure_token_here

# Directory for SQLite database, temp files, and completed downloads
DATA_DIR=/data

# Logging verbosity (e.g., info, debug, trace)
RUST_LOG=info,vod_worker=debug
