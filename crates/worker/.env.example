# Twitch VOD Manager Cloud Worker Configuration
#
# Copy to .env. YouTube/GDrive/Twitch client id+secret apply to native vod-worker,
# Tauri process env, and Dokploy app env. docker-compose.yml only injects WORKER_* /
# DATA_DIR / RUST_LOG — add extra keys to environment: if you need them in Compose.
#
# Twitch OAuth tokens, S3, and WebDAV are not env: set them in desktop Settings and
# use Sync Settings to VPS.

# --- Worker runtime ---
WORKER_PORT=8080
# Alias: PORT

DATA_DIR=/data

RUST_LOG=info,vod_worker=debug

# --- Worker login ---
# Bearer / X-API-Key. Required for authenticated requests. Alias: API_KEY
WORKER_API_KEY=generate_a_secure_token_here

# --- Twitch login (Helix OAuth client) ---
# Required for user OAuth login (empty / kimne78 web client is rejected).
# Non-empty secret -> authorization code flow; empty secret -> implicit flow.
# OAuth Redirect URL must match character-for-character (http, no trailing slash, not https):
#   http://localhost:17563/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube login (Google OAuth client) ---
# Optional. Empty -> built-in desktop default.
# Redirect: http://localhost:17564/auth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Google Drive login ---
# Optional. Empty -> YOUTUBE_* -> built-in desktop default.
# Redirect: http://localhost:17565/auth/callback
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
